package my-namespcae:my-package;

interface my-interface {
  resource my-resource {
    get-param: func(a: bool, b: option<option<f32>>);
    get-result-anon: func() -> result<f32, bool>;
    get-result-named: func() -> (a: f32);
  }
  record my-record {
    get-field: list<f32>,
  }
  variant my-variant {
    get-case(option<tuple<bool, bool, option<list<f32>>, bool>>),
    other-case(u32),
  }
  type took-resource-param = option<option<f32>>;
  type took-resource-result-anon = result<f32, bool>;
  type took-resource-result-named = f32;
  type took-record-field = list<f32>;
  type took-variant-case = option<tuple<bool, bool, option<list<f32>>, bool>>;
}
